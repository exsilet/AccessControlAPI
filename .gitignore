## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Rider files
.idea/
*.sln.iml

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
packages/
*.nupkg
NuGet.exe
NuGet.Config
.nuget/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# ReSharper
*.[Rr]e[Ss]harper

# JetBrains Rider
*.sln.iml

# OS files
.DS_Store

# Database files
*.db
*.mdf
*.ldf

# App specific
appsettings.Development.json

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# VS Code
.vscode/

# PostgreSQL (если есть локальные файлы)
postgres-data/